# Öffentliche URL der Marketing-Seite, ohne Slash am Ende.
# Wird für Canonical-Tags, OG-Metadaten, sitemap.xml und robots.txt genutzt.
# Auf Vercel als Environment Variable für Production setzen.
NEXT_PUBLIC_SITE_URL=https://gartenapp.example

# Ziel aller "Kostenlos starten"-Buttons (die eigentliche App).
NEXT_PUBLIC_APP_URL=https://app.gartenapp.example
